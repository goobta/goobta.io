---
import Base from '../layouts/Base.astro';

const name = 'Ankur Gupta';
const email = 'rukna1000@gmail.com';

// Venmo is a hand-drawn geometric V. The previous asset set it as an SVG <text>
// node with font-family/style/weight as presentation attributes, so it rendered
// as Georgia bold-italic among five geometric marks — and differently on every
// platform, since `system-ui` resolves per OS.
const links = [
  {
    key: 'github',
    label: 'GitHub',
    path: '/goobta',
    href: 'https://github.com/goobta',
    a11y: 'GitHub, github.com/goobta',
    svg: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    key: 'linkedin',
    label: 'LinkedIn',
    path: '/in/goobta',
    href: 'https://www.linkedin.com/in/goobta/',
    a11y: 'LinkedIn, linkedin.com/in/goobta',
    svg: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    key: 'email',
    label: 'Email',
    path: email,
    href: `mailto:${email}`,
    a11y: `Email, ${email}`,
    svg: `<svg viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"/></svg>`,
  },
  {
    key: 'strava',
    label: 'Strava',
    path: '/athletes/115751174',
    href: 'https://www.strava.com/athletes/115751174',
    a11y: 'Strava, strava.com/athletes/115751174',
    svg: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>`,
  },
  {
    key: 'spotify',
    label: 'Spotify',
    path: '/user/theultimatepanda',
    href: 'https://open.spotify.com/user/theultimatepanda',
    a11y: 'Spotify, open.spotify.com/user/theultimatepanda',
    svg: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>`,
  },
  {
    key: 'venmo',
    label: 'Venmo',
    path: '/u/agupta628',
    href: 'https://venmo.com/u/agupta628',
    a11y: 'Venmo, venmo.com/u/agupta628',
    svg: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4.0 4.6 L10.3 4.0 L11.6 15.2 C13.6 11.9 14.5 8.3 13.5 5.0 L19.4 3.8 C21.2 7.3 20.6 12.1 17.5 16.4 C16.1 18.4 14.7 19.8 13.5 20.6 L6.6 20.6 Z"/></svg>`,
  },
];

// Command table for the prompt, derived from `links` so the two can never
// drift. Keys are exactly the labels shown in the listing above — that
// listing is the only discovery affordance, by design.
const commands = Object.fromEntries(links.map((l) => [l.key, l.href]));
---

<Base title={name} description={`${name} — software and AI engineering.`}>
  <main>
    <div class="page">
      <h1 class="name">{name}<span class="stop" aria-hidden="true">.</span></h1>

      <nav class="index" aria-label="Profiles and contact">
        {
          links.map((link) => (
            <a
              class={`row r-${link.key}`}
              href={link.href}
              aria-label={link.a11y}
              {...(link.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <span class="ico" aria-hidden="true" set:html={link.svg} />
              <span class="label">{link.label}</span>
              <span class="path">{link.path}</span>
            </a>
          ))
        }
      </nav>

      <div class="prompt">
        <span class="sig" aria-hidden="true">~ %</span>

        {/* Rendered inert. The script below upgrades it into a real input, so
            with JS off this stays exactly the static prompt it was, and the
            six anchors above remain the only thing anyone depends on. */}
        <form class="field" id="cli" autocomplete="off" data-inert>
          <label class="vh" for="cmd">
            Type a destination — github, linkedin, email, strava, spotify or venmo — then press
            Enter to open it. Tab completes the name, and cycles when more than one matches.
          </label>
          <input
            class="cmd"
            id="cmd"
            type="text"
            hidden
            autocomplete="off"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="go"
            data-1p-ignore
            data-lpignore="true"
          />
          <span class="caret" aria-hidden="true"></span>
          <span class="ghost" aria-hidden="true"></span>
        </form>
      </div>

      <p class="resp" id="resp" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </main>

  <footer class="colophon">
    <span>goobta.io</span>
    <span>&copy; {name} {new Date().getFullYear()}</span>
  </footer>
</Base>

<style>
  /* ─────────────────────────────────────────────────────────────────────
     D1 × D2 hybrid.

     Sans (D1) carries the identity: the name and the link labels.
     Mono is confined to what is genuinely terminal work — the resource
     paths and the prompt line. Nothing decorative is set in mono.

     No per-row borders (D2). The listing is bracketed by two hairlines
     instead, so the block still has edges without ruling every row, and
     hover becomes a full-bleed selection bar rather than a rule colour.
     ───────────────────────────────────────────────────────────────── */

  main {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1.5rem;
  }

  .page {
    width: 100%;
    max-width: 36rem;
  }

  /* ── Masthead — pure D1 ──────────────────────────────────────────── */

  .name {
    /* optical left align: pull the A stem out to the rule edge */
    margin: 0 0 0 -0.025em;
    /* Deliberately not a clamp — the name holds 4rem at every width. It wraps
       to two lines on a phone rather than shrinking, which keeps the masthead
       the loudest thing on the page instead of letting it collapse into the
       listing. Fits down to 320px: the longest word sets ~165px at this size. */
    font-size: 4rem;
    font-weight: 640;
    line-height: 1.02;
    letter-spacing: -0.038em;
    color: var(--ink);
  }

  .stop {
    color: var(--accent);
    margin-left: -0.01em;
  }

  /* ── Listing — D2's paths and open rows, D1's labels ─────────────── */

  .index {
    margin-top: 1.75rem;
    padding: 0.375rem 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }

  .row {
    /* --lbcol sizes the label track in ch against the row's own font-size,
       so every path starts at the same x and the column self-corrects if
       the face ever changes. `max-content` would let each row size itself
       independently and the paths would not line up. */
    --lbcol: 9.25ch;

    position: relative;
    display: grid;
    grid-template-columns: 0.875rem var(--lbcol) minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0.625rem;
    margin: 0 -0.625rem;
    border-radius: 2px;
    font-size: 0.8125rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 120ms linear;
  }

  .label {
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.115em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    color: var(--ink-soft);
  }

  /* One 14px optical box, one colour, no shadow. The per-mark scale
     normalises the mismatched apparent weights of the six glyphs. */
  .ico {
    align-self: center;
    display: flex;
    line-height: 0;
    color: var(--ink-soft);
    transition: color 120ms linear;
  }

  .ico :global(svg) {
    display: block;
    width: 0.875rem;
    height: 0.875rem;
    /* An <svg> root's transform-origin has a history of resolving to 0 0
       rather than 50% 50%, which turns each optical scale into an
       off-centre nudge. */
    transform-box: border-box;
    transform-origin: 50% 50%;
  }

  .r-github .ico :global(svg) {
    transform: scale(0.94);
  }
  .r-linkedin .ico :global(svg) {
    transform: scale(0.9);
  }
  .r-email .ico :global(svg) {
    transform: scale(0.97);
  }
  .r-strava .ico :global(svg) {
    transform: scale(1.14);
  }
  .r-spotify .ico :global(svg) {
    transform: scale(0.94);
  }
  /* Was 1.06 when this was a thin geometric wedge. The real Venmo letterform
     is a solid, heavily weighted glyph, so it needs pulling back in line with
     the other filled marks rather than pushed up. */
  .r-venmo .ico :global(svg) {
    transform: scale(0.93);
  }

  .row:hover {
    background-color: var(--sel);
  }

  .row:hover .ico,
  .row:hover .path {
    color: var(--ink);
  }

  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    background-color: var(--sel);
  }

  /* ── Prompt — the one genuinely terminal element ─────────────────── */

  .prompt {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .sig {
    color: var(--accent);
  }

  /* The field is the caret's positioning context and must share the input's
     font and size exactly — the caret is placed in `ch`, which only lands on
     the character cell if both resolve to the same monospace metrics. */
  .field {
    /* The real advance per character is 1ch + tracking; `ch` is the glyph
       advance alone. Tokenised so the caret maths and the text can never
       disagree — they drifted 0.48px per character before this. */
    --track: 0.04em;

    position: relative;
    flex: 1 1 8rem;
    min-width: 0;
    display: flex;
    align-items: center;
    height: 0.875rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: var(--track);
  }

  .cmd {
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--ink);
    /* Our block caret replaces the native one. */
    caret-color: transparent;
  }

  .cmd:focus {
    outline: none;
  }

  .caret {
    position: absolute;
    left: 0;
    /* `--col` is the input's selectionStart, so the block tracks arrow keys and
       clicks, not just typed length. Monospace makes the ch math exact. */
    transform: translateX(calc(var(--col, 0) * (1ch + var(--track))));
    /* A full character cell, tracking included — so it reads as a block cursor
       sitting on a cell rather than a bar next to one. */
    width: calc(1ch + var(--track));
    height: 0.875rem;
    pointer-events: none;

    /* When a suggestion is showing, the caret carries its first character —
       the way a real block cursor sits on top of the glyph rather than
       hiding it. */
    display: flex;
    align-items: center;
    justify-content: center;
    font: inherit;
    letter-spacing: 0;
    line-height: 1;

    /* Unfocused: hollow. This is the field's focus indicator — a terminal
       shows an outlined block when its window loses focus, and a filled one
       when it has it. Static, because an unfocused cursor should not blink. */
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--ink-soft);
    animation: none;
  }

  .field:focus-within .caret {
    background: var(--accent);
    box-shadow: none;
    color: var(--paper);
    animation: caret-blink 1.1s steps(1, end) infinite;
  }

  /* Solid while a suggestion is up: the caret is holding a glyph, and
     blinking it would strobe the first letter of the hint. Specificity kept
     above the focus rule so it wins regardless of source order. */
  .field.has-ghost:focus-within .caret {
    animation: none;
  }

  /* The suggested remainder, muted. Starts one cell right of the caret,
     because the caret itself is displaying the first character. */
  .ghost {
    position: absolute;
    left: 0;
    transform: translateX(calc((var(--col, 0) + 1) * (1ch + var(--track))));
    white-space: pre;
    color: var(--ink-soft);
    pointer-events: none;
    user-select: none;
  }

  /* Visually hidden, still in the accessibility tree. Absolute positioning is
     load-bearing here as well as visually: without it the label is an in-flow
     flex item and displaces the input inside .field. */
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .resp {
    margin: 0.5rem 0 0;
    min-height: 1.2em;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  /* Colour reinforces, it is not the signal — the wording carries the meaning,
     so this does not rely on hue alone. */
  .resp.is-error {
    color: var(--danger);
  }

  @keyframes caret-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  /* Pinned to the foot of the viewport — body is a flex column and <main>
     takes the free space, so this sits at the bottom without positioning. */
  .colophon {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  /* ── Narrow ──────────────────────────────────────────────────────── */

  @media (max-width: 30rem) {
    .row {
      /* Drop the icon column and let the path fall under the label, rather
         than deleting the path — it is the most useful thing in the row.
         Rows grow to a real 44px touch target in the process. */
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.1875rem;
      padding: 0.625rem;
    }
    .ico {
      display: none;
    }
    .label,
    .path {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .ico {
      transition: none;
    }
    /* Must out-specify `.field:focus-within .caret`, which sets the blink —
       a bare `.caret` rule here would silently lose to it. */
    .caret,
    .field:focus-within .caret {
      animation: none;
    }
  }
</style>

<script define:vars={{ commands }}>
  // Progressive enhancement: the prompt ships inert and is upgraded here.
  // Every destination is already reachable through the six anchors above, so
  // nothing is lost if this never runs.
  const form = document.getElementById('cli');
  const input = document.getElementById('cmd');
  const resp = document.getElementById('resp');
  const caret = form.querySelector('.caret');
  const ghost = form.querySelector('.ghost');

  // Completion set is every destination published in the listing above, in the
  // same order — so the first suggestion is always the one nearest the top.
  const NAMES = Object.keys(commands);

  input.hidden = false;
  form.removeAttribute('data-inert');

  // Ready to type on load. Guarded to fine pointers: on a touch device
  // focusing an input forces the on-screen keyboard up over the page before
  // the visitor has seen anything, which is hostile. preventScroll keeps the
  // masthead in view if the prompt sits below the fold.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    input.focus({ preventScroll: true });
  }

  // Tab cycling remembers the prefix you actually typed, so repeated Tab walks
  // the matches for that stem instead of re-completing its own output.
  let stem = null;
  let cycle = 0;

  const matchesFor = (p) => (p ? NAMES.filter((n) => n.startsWith(p)) : []);
  const typed = () => input.value.trim().toLowerCase();

  // `ttl` auto-clears transient feedback. "opening x…" is a receipt for
  // something that already happened, so it expires; a "not found" is a
  // standing answer and stays until the next keystroke.
  let respTimer;
  const say = (msg, { ttl = 0, error = false } = {}) => {
    clearTimeout(respTimer);
    resp.textContent = msg;
    resp.classList.toggle('is-error', error && !!msg);
    if (ttl) {
      respTimer = setTimeout(() => {
        resp.textContent = '';
        resp.classList.remove('is-error');
      }, ttl);
    }
  };

  const render = () => {
    const col = input.selectionStart ?? input.value.length;
    caret.style.setProperty('--col', col);
    ghost.style.setProperty('--col', col);

    // Only hint when the cursor is at the end — a suggestion trailing a
    // mid-string cursor would be describing text that is not there.
    const v = typed();
    const atEnd = col === input.value.length;
    const hit = atEnd && v ? matchesFor(v)[0] : null;
    const rest = hit && hit !== v ? hit.slice(v.length) : '';

    caret.textContent = rest ? rest[0] : '';
    ghost.textContent = rest ? rest.slice(1) : '';
    form.classList.toggle('has-ghost', !!rest);
  };

  // selectionStart lags the keystroke on keydown, so sync after the event loop
  // turn for key handling; input/click/select fire late enough already.
  const renderSoon = () => setTimeout(render, 0);

  ['input', 'click', 'select', 'focus'].forEach((e) => input.addEventListener(e, render));
  ['keydown', 'keyup'].forEach((e) => input.addEventListener(e, renderSoon));

  input.addEventListener('input', () => {
    say('');
    stem = null;
    cycle = 0;
  });

  input.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey) return;

    const cur = typed();
    // Never swallow Tab on an empty field — that would trap the keyboard.
    if (!cur) return;

    if (stem === null) stem = cur;
    const ms = matchesFor(stem);

    // Nothing to complete, or already sitting on the only match: let Tab move
    // focus so the field is always escapable.
    if (!ms.length || (ms.length === 1 && ms[0] === cur)) return;

    e.preventDefault();
    input.value = ms[cycle % ms.length];
    cycle += 1;
    input.setSelectionRange(input.value.length, input.value.length);
    say('');
    render();
  });

  // Click anywhere that is not itself interactive and you land in the prompt —
  // the whole page behaves like a terminal window. Guarded two ways: real
  // controls keep their own click, and an active text selection is left alone
  // so highlighting the email address does not yank focus away mid-drag.
  document.addEventListener('click', (e) => {
    if (e.target.closest('a, button, input, textarea, select, label, [contenteditable]')) return;
    if (String(window.getSelection() || '')) return;
    input.focus({ preventScroll: true });
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const cmd = input.value.trim().toLowerCase();
    if (!cmd) return;

    const url = commands[cmd];
    if (!url) {
      // Clear on a miss too, so the prompt is always ready for the next try
      // and the message is the only record of what happened.
      input.value = '';
      stem = null;
      cycle = 0;
      // Echo the command back — the field has just been cleared, so this
      // message is the only remaining record of what was typed.
      say(`command not found: ${cmd}`, { error: true });
      render();
      return;
    }

    say(`opening ${cmd}…`, { ttl: 1000 });
    input.value = '';
    stem = null;
    cycle = 0;
    render();

    // Submit is a user gesture, so window.open is not blocked here.
    if (url.startsWith('mailto:')) window.location.href = url;
    else window.open(url, '_blank', 'noopener,noreferrer');
  });

  render();
</script>
